{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@repo/oxc-config/oxlint/react.json"],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs"
  ],
  "overrides": [
    {
      "files": ["*.config.ts", "e2e/**", "scripts/**", "src/**/*.test.ts"],
      "env": {
        "node": true
      }
    }
  ],
  "ignorePatterns": ["next-env.d.ts", ".next/**", "test-results/**", "playwright-report/**"]
}
