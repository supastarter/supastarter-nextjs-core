{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@repo/oxc-config/oxlint/react.json"],
  "overrides": [
    {
      "files": ["*.config.ts", "e2e/**", "scripts/**", "src/**/*.test.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "dist/**",
    ".output/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
