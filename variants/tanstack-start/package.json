{
  "name": "@repo/tanstack-start",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "typegen": "node scripts/typegen.ts",
    "type-check": "pnpm run typegen && tsc --noEmit",
    "lint": "pnpm run typegen && oxlint --type-aware --deny-warnings",
    "lint:fix": "pnpm run typegen && oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/test.ts",
    "check": "pnpm run format:check && pnpm run type-check && pnpm run lint && pnpm run test",
    "build": "vite build",
    "start": "srvx serve --prod --port 3001 --entry dist/server/server.js --static ../client",
    "test:e2e": "pnpm run build && playwright test",
    "verify": "pnpm run check && pnpm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@repo/oxc-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "srvx": "1.0.8",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
